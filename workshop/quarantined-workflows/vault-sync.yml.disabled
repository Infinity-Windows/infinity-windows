# Mirror the install brain (Supabase) into the Obsidian vault as markdown.
# One-way: DB = truth, vault = wiki. Regenerates per-type profiles + synthesized
# tips/pitfalls every run and appends new per-memo files, then publishes the
# result to the `vault-mirror` branch for a git-synced Obsidian to follow.
#
# This does NOT feed the Ask / Infinity AI feature. Ask is grounded on the
# knowledge_docs rows uploaded through the app, not on these files.
#
# Required repo secret: SUPABASE_SERVICE_ROLE_KEY — either a new-format secret
# key (sb_secret_...) or a legacy service_role JWT, for project
# czprjcskmzzagdztqonm. Both bypass RLS so the sync can read every install event
# and window type. Add it in Settings -> Secrets and variables -> Actions.

name: Vault brain sync

on:
  schedule:
    # Daily at 08:00 UTC (~1-2am Mountain).
    - cron: "0 8 * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: vault-sync
  cancel-in-progress: false

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      # First, before checkout or Node, so a missing credential is always the
      # reported cause instead of being hidden behind an earlier step failing.
      - name: Check the Supabase credential is present
        env:
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
        run: |
          if [ -z "$SUPABASE_SERVICE_ROLE_KEY" ]; then
            echo "::error::SUPABASE_SERVICE_ROLE_KEY secret is not set — add it in repo Settings > Secrets and variables > Actions. Use a secret key (sb_secret_...) from the czprjcskmzzagdztqonm project; a legacy service_role JWT also works."
            exit 1
          fi
          echo "Credential present."

      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node
        uses: actions/setup-node@v4
        with:
          # The only .nvmrc in this repo is at the root — app/.nvmrc does not
          # exist, and pointing at it failed this job on every run.
          node-version-file: .nvmrc
          cache: npm
          cache-dependency-path: app/package-lock.json

      - name: Install app dependencies (pinned @supabase/supabase-js)
        working-directory: app
        run: npm ci

      - name: Expose deps to the root script
        # scripts/vault-sync.mjs resolves its bare import from ../node_modules.
        run: ln -sfn app/node_modules node_modules

      - name: Sync the vault from Supabase
        env:
          SUPABASE_URL: https://czprjcskmzzagdztqonm.supabase.co
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
        run: node scripts/vault-sync.mjs

      - name: Remove the temporary symlink
        if: always()
        run: rm -f node_modules

      # Publishes to the vault-mirror branch, not master: this repo's rules
      # require changes to master to arrive as a reviewed pull request, which a
      # nightly bot cannot satisfy on its own. See scripts/publish-vault.sh.
      - name: Publish the vault to its own branch
        run: scripts/publish-vault.sh

  # This is the job the whole failure-notification idea came from: it runs at
  # 08:00 UTC with nobody watching, and it had been failing for about a week
  # before anyone noticed. A nightly job with no alerting is a nightly job you
  # will find out about late.
  notify-failure:
    name: Tell Slack if this broke
    needs: sync
    if: failure()
    uses: ./.github/workflows/notify-failure.yml
    with:
      workflow: ${{ github.workflow }}
      detail: >-
        The Obsidian notes did not update overnight, so they are now behind the
        database. Nothing users see is affected, and the Ask feature is
        unaffected — it does not read these notes.
    secrets: inherit
