# Forge Workshop settings — copy to app/.env.workshop.local (gitignored) and fill in.
#
# Workshop mode is the same app pointed at a SEPARATE Supabase project holding
# synthetic accounts and data. It never reads app/.env (that file holds the
# production URL and key), and it refuses to start unless every value below is
# set, names the same non-production project, and is a browser-safe key.
#
# Start it with:   node scripts/workshop/start.mjs     (from the repo root)
# It serves at http://127.0.0.1:5278 — a different origin from the normal dev
# app on :5173, so saved data and sign-ins on this machine never mix.
#
# Nothing is contacted until these settings pass. There are deliberately no
# real values here.

# The workshop project's ref: the 20 lowercase letters in its URL. Or `local`
# for a local Supabase stack (`supabase start`). Production refs are refused.
VITE_WORKSHOP_SUPABASE_REF=

# Exactly https://<ref>.supabase.co — no path, no trailing pieces.
# For `local`: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# The workshop project's PUBLIC browser key: a publishable key
# (sb_publishable_…) or the legacy anon JWT (eyJ…, role "anon", same ref).
# Secret (sb_secret_…) and service-role keys are refused — they bypass row
# security and must never reach a browser.
VITE_SUPABASE_ANON_KEY=
