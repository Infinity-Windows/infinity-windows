# Supabase project credentials (Project Settings -> API)
#
# There is ONE shared Infinity Windows Supabase project: czprjcskmzzagdztqonm.
# It is the project the deployed app talks to, so these values are correct as-is
# — `cp .env.example .env` and you are done, no editing required. The anon key is
# safe in git: it is already compiled into the JavaScript we serve publicly, and
# row-level security is what actually protects the data.
#
# If you point the app at a different project, a red "Wrong database" banner
# appears in the app so the mismatch can't go unnoticed (see lib/supabaseProject).
VITE_SUPABASE_URL=https://czprjcskmzzagdztqonm.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN6cHJqY3NrbXp6YWdkenRxb25tIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQxMzE3MjMsImV4cCI6MjA5OTcwNzcyM30.4Dz3vnx5EjAGQ52yyViEGMiAQtjTWsvjYqAyMi40JWI

# Optional: which project the app EXPECTS. Only for someone deliberately working
# against a different Supabase project — it moves the "Wrong database" banner to
# the project named here, so the banner stops crying wolf. It does NOT change
# which project the app connects to: that is VITE_SUPABASE_URL above, and setting
# this alone will not switch databases. Leave it out and the shared project above
# stays the expected one. A bare ref or a full URL both work; blank falls back.
#VITE_EXPECTED_SUPABASE_PROJECT_REF=czprjcskmzzagdztqonm

# Web push (p1-10 follow-up): the PUBLIC VAPID key is safe to ship to the client.
# Generate a pair with: npx web-push generate-vapid-keys
# Keep the matching PRIVATE key server-side only (Supabase function secret VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
